    <!--  Course Dates Banner  -->
    <string name="core_dates_reset_dates_banner_button">Ngày đến hạn thay đổi</string>
    <string name="core_dates_reset_dates_banner_header">Bạn đã bỏ lỡ một số thời hạn?</string>
    <string name="core_dates_reset_dates_banner_body">Đừng lo lắng - hãy thay đổi lịch trình mà chúng tôi đề xuất để hoàn thành các bài tập quá hạn mà không bị mất tiến độ.</string>
    <string name="core_dates_info_banner_body">Chúng tôi đã xây dựng một lịch trình gợi ý để giúp bạn đi đúng hướng. Nhưng đừng lo lắng – nó linh hoạt để bạn có thể học theo tốc độ của riêng mình. Nếu bạn tình cờ bị tụt lại phía sau, bạn sẽ có thể điều chỉnh ngày để giữ đúng hướng.</string>
    <string name="core_dates_upgrade_to_graded_banner_body">Để hoàn thành các bài tập được chấm điểm trong khóa học này, bạn có thể nâng cấp ngay hôm nay.</string>
    <string name="core_dates_upgrade_to_reset_banner_body">"Bạn đang kiểm tra khóa học này, nghĩa là bạn không thể tham gia vào các bài tập được chấm điểm. Có vẻ như bạn đã bỏ lỡ một số thời hạn quan trọng dựa trên lịch trình được chúng tôi đề xuất. Để hoàn thành các bài tập được chấm điểm như một phần của khóa học này và chuyển các bài tập quá hạn sang tương lai, bạn có thể nâng cấp ngay hôm nay. "</string>
    <string name="core_dates_shift_dates_successfully_title">Ngày đến hạn đã được thay đổi</string>
    <string name="core_dates_shift_dates_successfully_msg">Ngày đến hạn của bạn đã được thay đổi thành công để giúp bạn đi đúng hướng.</string>
    <string name="core_dates_shift_dates_unsuccessful_msg">Không thể thay đổi ngày của bạn. Vui lòng thử lại.</string>
